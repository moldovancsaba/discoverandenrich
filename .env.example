# .env.example -- variable NAMES only. Never put a real value in this file.
#
# This is a map of what the code and docs read, not a single file to copy. The
# real files are gitignored (`.env*` in .gitignore) and are NOT a root `.env`:
#
#   .env.cogmap  .env.seyu  .env.dvsc  .env.classscout   one per tenant
#
# Each tenant file is sourced by the agent before any API call
#   source "${RAE_ENV_DIR:-$RAE_ROOT}/.env.<tenantId>"
# and normally lives OUTSIDE the clone (see prompts/RUNTIME_PATHS.md). Values come
# from the repo owner or the target app's Vercel project, never from a doc.
# Sections below say which file, or which process, each name belongs to.

# ---------------------------------------------------------------------------
# Path contract. Process environment, not a tenant file. On the OpenClaw host it
# is set machine-wide (prompts/RUNTIME_PATHS.md; docs/OPENCLAW_OPERATOR_HANDOVER.md).
# ---------------------------------------------------------------------------
# Absolute path to this clone (the directory holding tenants.json). Required by
# the prompts; if unset they fall back to the resolution order in RUNTIME_PATHS.md.
# Also read by run-cogmap-enrichment-lean.js.
RAE_ROOT=
# Directory that holds the .env.<tenantId> files. Optional; falls back to RAE_ROOT.
# Also read by run-cogmap-enrichment-lean.js.
RAE_ENV_DIR=

# ---------------------------------------------------------------------------
# .env.cogmap, .env.seyu, .env.dvsc  (schemaFamily sales-lead-api; target:
# salesleadgenerator). Also read by run-cogmap-enrichment-lean.js.
# ---------------------------------------------------------------------------
# Required. salesleadgenerator ingest key, sent as the `x-api-key` header. One key
# is shared by all three tenants (docs/AGENT_RUNTIME_FINDINGS.md); there is no
# separate seyu key.
SLG_API_KEY=

# ---------------------------------------------------------------------------
# .env.classscout  (schemaFamily program-api; target: classscout.ai /api/ingest)
# ---------------------------------------------------------------------------
# Required. Bearer token for classscout's POST /api/ingest. Unrelated to SLG_API_KEY.
INGEST_API_KEY=
# Required for any run that uploads an image (scripts/test-classscout-live.js live
# mode, scripts/seed-classscout.js). ImgBB hosts the provider images.
IMGBB_API_KEY=
# Only scripts/seed-classscout.js (direct database write). Not needed by the agent.
MONGODB_URI=
# Only scripts/seed-classscout.js, and only printed in its log line. Default bos,nyc,la.
# CLASSSCOUT_CITIES=

# ---------------------------------------------------------------------------
# Next.js app, the local-only /openclaw admin page (lib/openclaw.ts, middleware.ts)
# ---------------------------------------------------------------------------
# Optional. The OpenClaw workspace the page reads and runs tasks in. Default:
# /Users/Shared/Projects/OpenClaw/.openclaw/workspace. Do NOT set this on a hosted
# deployment: middleware.ts answers 404 for /openclaw there on purpose.
OPENCLAW_WORKSPACE=
# VERCEL is set by the Vercel platform, never by hand. middleware.ts reads it to
# refuse /openclaw on a deployment. Listed only so it is not mistaken for config.

# ---------------------------------------------------------------------------
# Search router (search-router/seyu-search-router, search-router/bin/run-router-search.sh).
# Process environment of the router. Every name here is optional.
# ---------------------------------------------------------------------------
# Router directory, if not the default sibling of search-router/bin.
SEYU_SEARCH_ROUTER_ROOT=
# Path of the router config JSON. Default: seyu-search-router.config.json beside
# the package (template: seyu-search-router.config.example.json).
SEYU_SEARCH_CONFIG=
# Where the router keeps its persisted state (budgets). Default: .state in the package.
SEYU_SEARCH_STATE_DIR=
# Contact reference placed in the User-Agent. Default: contact-not-configured.
SEYU_SEARCH_CONTACT=
# Base URL of a self-hosted SearXNG. Setting it enables that engine.
SEARXNG_URL=
# Setting it enables the SerpAPI engine.
SERPAPI_KEY=
# Setting it enables the Yelp Fusion engine.
YELP_API_KEY=

# ---------------------------------------------------------------------------
# Credential-rotation gate (scripts/assert-credentials-rotated.js, called by
# scripts/purge-history.sh; issues #9 and #10). Export these in a one-off shell
# for the run. Never store them in a file.
# ---------------------------------------------------------------------------
# Required by the gate: the previously exposed values, which must now be rejected.
OLD_COGMAP_MONGODB_URI=
OLD_SEYU_MONGODB_URI=
OLD_SLG_API_KEY=
# Optional. Default https://salesleadgenerator.vercel.app
SLG_API_BASE=
# Optional, scripts/purge-history.sh only. Git remote to mirror and rewrite.
REMOTE=

# ---------------------------------------------------------------------------
# Not listed on purpose: older docs mention tenant-scoped MongoDB URIs in
# .env.cogmap (COGMAP_MONGODB_URI, SEYU_MONGODB_URI; docs/RUNTIME_ARCHITECTURE_NOTES.md
# section 3). No code in this repo reads them.
# ---------------------------------------------------------------------------
